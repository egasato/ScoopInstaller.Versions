            "hash": "79aea41e8700ecaffc04fa3975d5eee30aa49ab566f7dea771fc2ec946d665e1"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/adxja35it7ks6glvjalvn5y2ohna_159.0.8144.0/159.0.8144.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "47855ad4a03accf494dea37f5e6dfeac8013bb9c0996ccaee68474adb9878006"
